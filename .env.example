# Copy this file to .env and adjust the values before running in production.

# Port the HTTP server listens on.
PORT=3000

# Secret used to sign JSON Web Tokens. MUST be changed for any real deployment.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login session stays valid.
TOKEN_EXPIRES_IN=8h

# Path to the SQLite database file (relative paths resolve from the repo root).
DATABASE_FILE=data/attendance.sqlite

# Password given to the demo accounts created by `npm run seed`.
SEED_PASSWORD=password123
