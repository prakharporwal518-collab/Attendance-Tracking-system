# Copy this file to .env and adjust the values before running in production.

# Port the HTTP server listens on.
PORT=3000

# Secret used to sign JSON Web Tokens. MUST be changed for any real deployment.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login session stays valid.
TOKEN_EXPIRES_IN=8h

# Path to the SQLite database file (relative paths resolve from the repo root).
DATABASE_FILE=data/attendance.sqlite

# Password given to the demo accounts created by `npm run seed`.
SEED_PASSWORD=password123

# Currency the expense tracker formats amounts in (ISO 4217 code).
CURRENCY=INR

# ── Deployment (Render, Railway, Fly, a VPS…) ────────────────────────────────

# Your administrator login. Set both or neither. Applied on every start, so
# changing ADMIN_PASSWORD and redeploying is how you recover a lost password.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-something-private
# ADMIN_NAME=Your Name

# Load the demo students, courses and attendance history even in production.
# The demo password is published in the README, so use this only for a demo.
# SEED_DEMO_DATA=true

# Trust the X-Forwarded-* headers of a TLS-terminating proxy. Defaults to true
# in production, which is correct on Render, Railway, Heroku and behind nginx.
# TRUST_PROXY=true

# On a host with a persistent disk, point the database at it so that deploys
# do not wipe your data:
# DATABASE_FILE=/var/data/attendance.sqlite
